# ---- client (baked into the browser bundle) ----

# Deployed WritOptions address on GIWA Sepolia
NEXT_PUBLIC_CORE_ADDRESS=

# Deployed TestUSDC (faucet-backed settlement token) on GIWA Sepolia
NEXT_PUBLIC_USDC_ADDRESS=

# Pyth on GIWA Sepolia
NEXT_PUBLIC_PYTH_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43
NEXT_PUBLIC_BTC_USD_FEED_ID=0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43

# ---- server (route handlers only, never exposed to the browser) ----

# Desk quote signer key — MUST match the quoteSigner configured on-chain.
QUOTER_PRIVATE_KEY=

# WritOptions address for the EIP-712 signing domain
CORE_ADDRESS=

# Desk pricing knobs (optional). TTL defaults to 20s on GIWA (Flashblocks).
# IV_DEFAULT=0.55
# DESK_SPREAD=0.10
# QUOTE_TTL_SEC=20
